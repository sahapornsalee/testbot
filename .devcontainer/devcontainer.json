{
  // GitHub Codespaces: runs the API and web UI in the cloud.
  // Only port 3000 (web UI) is forwarded; it is private to your GitHub account by default.
  "name": "Universal Downloader",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "postCreateCommand": "bash scripts/codespaces/setup.sh",
  "postStartCommand": "bash scripts/codespaces/start.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Universal Downloader", "onAutoForward": "openBrowser" },
    "8000": { "label": "API (internal)", "onAutoForward": "ignore" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  }
}
