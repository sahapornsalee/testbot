# Universal Downloader configuration. Copy to `.env` and adjust.
# NEVER commit `.env`. Do not put real secrets in this example file.

# development | test | production. Production refuses to start without AUTH_REQUIRED=true.
APP_ENV=development
# Interface the API binds to. Keep 127.0.0.1 for Local Mode.
APP_HOST=127.0.0.1
API_PORT=8000
# Used by docker-compose for the published web port.
WEB_PORT=3000

# SQLite database for job metadata and history (relative to services/api when run locally).
DATABASE_URL=sqlite:///./data/app.db
# Finished files (one folder per job) and in-progress temporary files.
DOWNLOAD_DIR=./data/downloads
TEMP_DIR=./data/tmp

# Limits
MAX_FILE_SIZE_MB=1024
# Total disk budget for DOWNLOAD_DIR + TEMP_DIR.
MAX_STORAGE_MB=10240
MAX_CONCURRENT_JOBS=2
MAX_ACTIVE_JOBS_PER_OWNER=5
JOB_TIMEOUT_SECONDS=1800
CONNECT_TIMEOUT_SECONDS=10
READ_TIMEOUT_SECONDS=30
MAX_REDIRECTS=5
# Finished files are deleted (job becomes "expired") after this many hours.
TEMP_FILE_TTL_HOURS=6
CLEANUP_INTERVAL_SECONDS=300

# Requests (inspect/create) allowed per minute per client IP and per session/token.
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=16384

# Comma separated CORS allowlist. Never use * in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication. Must be true for any deployment reachable by other people.
AUTH_REQUIRED=false
# Comma separated bearer tokens (each >= 24 chars) used when AUTH_REQUIRED=true.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=

# Media downloads via yt-dlp (true/false).
YTDLP_ENABLED=true
# Optional path to ffmpeg(.exe) or its folder, if it is not on PATH.
FFMPEG_LOCATION=
MEDIA_INSPECT_TIMEOUT_SECONDS=60

# Web (Next.js): where the web server forwards /api/v1/*. Read at build time.
API_INTERNAL_URL=http://127.0.0.1:8000
